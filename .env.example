NODE_ENV=development
PORT=4000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Database (matches docker-compose.yml)
POSTGRES_DB=podcast_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/podcast_db

# Test database (matches docker-compose.test.yml — separate DB, never touches dev data)
POSTGRES_DB_TEST=podcast_db_test
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/podcast_db_test

# Placeholders — implement in later tickets:
# JWT_SECRET=change-me
# JWT_EXPIRATION=7d
